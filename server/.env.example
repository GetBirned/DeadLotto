DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="change-me-in-production"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Optional: without these, challenge suggestions are still saved to the database,
# but no email is sent (a warning is logged instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be a real email address (not the SMTP username) - most providers reject
# a bare username in the `From` header. Resend's sandbox sender works until you
# verify your own domain with them: "DeadLotto <onboarding@resend.dev>"
EMAIL_FROM="DeadLotto <onboarding@resend.dev>"
CHALLENGE_SUGGESTION_EMAIL_TO="dartbirnie@gmail.com"

# Optional: without these, avatar uploads are saved to local disk (fine for a
# single-instance dev/small deploy, not durable across redeploys or multiple
# instances). Set all four (Cloudflare R2, or any S3-compatible bucket) to
# switch to object storage.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Public base URL avatar images are served from - e.g. your R2 bucket's public
# dev URL, or a custom domain/CDN pointed at the bucket.
S3_PUBLIC_URL_BASE=
