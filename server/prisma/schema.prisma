generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  passwordHash       String
  profilePictureUrl  String?
  steamInfo          String?
  steamId64          String?
  steamDisplayName   String?
  steamAvatarUrl     String?
  allTimeWins        Int      @default(0)
  allTimeLosses      Int      @default(0)
  isAdmin            Boolean  @default(false)
  isOwner            Boolean  @default(false)
  favoriteHeroSlug   String?
  profileAccentColor String?
  hiddenFromLeaderboard Boolean @default(false)
  savedDiscordWebhookUrl String?
  createdAt          DateTime @default(now())

  friendshipsInitiated Friendship[]        @relation("FriendshipUser")
  friendshipsReceived  Friendship[]        @relation("FriendshipFriend")
  lobbyPlayers         LobbyPlayer[]
  hostedLobbies        Lobby[]             @relation("LobbyHost")
  challengeSuggestions ChallengeSuggestion[]
  gameHistory          GameHistoryEntry[]
  achievements         UserAchievement[]
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  status    String   @default("pending") // pending | accepted
  createdAt DateTime @default(now())

  user   User @relation("FriendshipUser", fields: [userId], references: [id])
  friend User @relation("FriendshipFriend", fields: [friendId], references: [id])

  @@unique([userId, friendId])
}

model Lobby {
  id                     String   @id @default(cuid())
  inviteCode             String   @unique
  hostUserId             String
  status                 String   @default("lobby")
  numHeroes              Int      @default(3)
  numChallenges          Int      @default(1)
  disabledChallengeSlugs String   @default("[]")
  disabledHeroSlugs      String   @default("[]")
  rerollsAllowed         Int      @default(0)
  discordWebhookUrl      String?
  lastOutcome            String?
  lastShareCode          String?
  createdAt              DateTime @default(now())

  host    User          @relation("LobbyHost", fields: [hostUserId], references: [id])
  players LobbyPlayer[]
}

model LobbyPlayer {
  id                String  @id @default(cuid())
  lobbyId           String
  userId            String
  rolledHeroesJson  String  @default("[]")
  lockedHeroSlug    String?
  rolledChallengesJson String @default("[]")
  rerollsUsed       Int     @default(0)
  kills             Int?
  deaths            Int?
  souls             Int?
  sessionWins       Int     @default(0)
  sessionLosses     Int     @default(0)

  lobby Lobby @relation(fields: [lobbyId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([lobbyId, userId])
}

model GameHistoryEntry {
  id           String   @id @default(cuid())
  userId       String
  lobbyId      String?
  heroSlug     String
  challengeName String
  outcome      String
  kills        Int
  deaths       Int
  souls        Int
  finishedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model UserAchievement {
  id                String   @id @default(cuid())
  userId            String
  achievementSlug   String
  unlockedAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, achievementSlug])
}

// A permanent, public snapshot of a finished game, created the moment everyone's
// stats are in. Deliberately denormalized (plain username/avatar strings, not a
// live User relation) so a shared link keeps showing exactly what it showed at
// share time, even if the lobby gets reused for another round ("Play Again" resets
// Lobby/LobbyPlayer) or a player later renames/deletes their account.
model SharedGameSummary {
  id        String   @id @default(cuid())
  shareCode String   @unique
  outcome   String
  createdAt DateTime @default(now())

  players SharedGameSummaryPlayer[]
}

model SharedGameSummaryPlayer {
  id                String @id @default(cuid())
  summaryId         String
  username          String
  profilePictureUrl String?
  heroSlug          String?
  challengeNames    String
  kills             Int
  deaths            Int
  souls             Int
  sessionWins       Int
  sessionLosses     Int

  summary SharedGameSummary @relation(fields: [summaryId], references: [id])
}

model ChallengeSuggestion {
  id          String   @id @default(cuid())
  userId      String
  challengeName String
  details     String
  status      String   @default("pending") // pending | approved | rejected
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
